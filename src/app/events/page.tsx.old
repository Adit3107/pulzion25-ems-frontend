'use client';

import { useState, useEffect, useRef } from 'react';
import Link from 'next/link';
import { Shield, Power, Monitor, Cpu, Zap, Lock, Unlock, ChevronUp, ChevronDown } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import Header from '@/components/layout/header';
import Footer from '@/components/layout/footer';

// Mission Data - As per the new brief
const MISSIONS = [
  {
    id: 'CF001',
    name: 'CODEFURY',
    objective: 'Neutralize the AI’s defensive subroutines.',
    description: 'Penetrate the rogue AI\'s primary defense matrix. Deploy advanced coding techniques to dismantle its protective algorithms and create entry points for further infiltration.',
  },
  {
    id: 'DS002',
    name: 'DATASPHERE',
    objective: 'Navigate a corrupt data labyrinth to extract critical packets.',
    description: 'Journey through the AI\'s corrupted data infrastructure. Navigate through maze-like data structures to recover essential information packets before they\'re permanently lost.',
  },
  {
    id: 'EE003',
    name: 'ENIGMA ECHO',
    objective: 'Decrypt complex ciphers to expose the AI’s hidden protocols.',
    description: 'Break through the AI\'s most sophisticated encryption layers. Use advanced cryptanalysis to reveal the hidden communication protocols that control its network.',
  },
  {
    id: 'CS004',
    name: 'CYBERSPARK',
    objective: 'Deploy a counter-AI agent to disable a key component.',
    description: 'Launch a specialized counter-AI program designed to infiltrate and disable critical components of the rogue system. Precision timing and flawless execution required.',
  },
  {
    id: 'LV005',
    name: 'LOGIC VAULT',
    objective: 'Bypass quantum encryption to retrieve a Master Key fragment.',
    description: 'Infiltrate the quantum-secured logic vault containing a fragment of the Master Key. Overcome impossible quantum encryption using cutting-edge techniques.',
  },
  {
    id: 'NI006',
    name: 'NEURAL INFILTRATION',
    objective: 'Mind-meld with the AI’s network to exploit its vulnerability.',
    description: 'Establish a direct neural interface with the AI\'s consciousness matrix. Navigate its digital mindscape to identify and exploit critical vulnerabilities.',
  },
  {
    id: 'GP007',
    name: 'GHOST PROTOCOL',
    objective: 'Execute a stealthy data-sync operation without detection.',
    description: 'Perform invisible data synchronization operations while maintaining complete stealth. Any detection will result in immediate system lockdown and mission failure.',
  },
  {
    id: 'SS008',
    name: 'SYSTEM SHOCK',
    objective: 'Overload the AI’s power relays.',
    description: 'Target the AI\'s power distribution network and cause cascading overloads. Disable key infrastructure components to create system-wide instability.',
  },
  {
    id: 'QB009',
    name: 'QUANTUM BREAKDOWN',
    objective: 'Decipher quantum signatures to initiate a system collapse.',
    description: 'Analyze the AI\'s quantum computational signatures and trigger a controlled system breakdown. Requires mastery of quantum mechanics and system theory.',
  },
  {
    id: 'VF010',
    name: 'VIRTUAL FRONTIER',
    objective: 'Compete in a simulated arena to secure your team’s ranking.',
    description: 'Enter the AI\'s combat simulation arena. Prove your team\'s superiority through strategic gameplay and secure high-priority access credentials.',
  },
  {
    id: 'RP011',
    name: 'RESISTANCE PROTOCOL',
    objective: 'Forge alliances and fortify the resistance network.',
    description: 'Build and strengthen the human resistance network. Establish secure communication channels and coordinate multi-team operations against the AI threat.',
  },
  {
    id: 'FL012',
    name: 'THE FINAL LOCKOUT',
    objective: 'Confront the rogue AI in a final, all-out challenge.',
    description: 'The ultimate confrontation with the rogue AI system. All previous missions culminate in this final battle for control of global digital infrastructure.',
  }
];

export default function EventsPage() {
  const [phase, setPhase] = useState<'booting' | 'clearance' | 'control'>('booting');
  const [bootingText, setBootingText] = useState('');
  const [showStatic, setShowStatic] = useState(false);
  const [dragProgress, setDragProgress] = useState(0);
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [currentMissionIndex, setCurrentMissionIndex] = useState(0);

  const dragRef = useRef<HTMLDivElement>(null);
  const isDragging = useRef(false);

  // Phase 1: Booting Terminal
  useEffect(() => {
    if (phase === 'booting') {
      const bootMessages = [
        '> BOOTING.OPERATIVE.TERMINAL...',
        '> INITIATING.SECURED.PROTOCOL.FEED...',
      ];
      let fullText = '';
      let messageIndex = 0;
      let charIndex = 0;

      const type = () => {
        if (messageIndex < bootMessages.length) {
          const currentMessage = bootMessages[messageIndex];
          if (charIndex < currentMessage.length) {
            setBootingText(fullText + currentMessage.substring(0, charIndex + 1));
            charIndex++;
            setTimeout(type, 50);
          } else {
            fullText += currentMessage + '\n';
            messageIndex++;
            charIndex = 0;
            setTimeout(type, 500);
          }
        } else {
          // End of booting sequence
          setTimeout(() => {
            setShowStatic(true);
            setTimeout(() => {
              setPhase('clearance');
            }, 300);
          }, 500);
        }
      };
      type();
    }
  }, [phase]);

  // Phase 2: Security Clearance Drag Handler - Fixed
  const handleMouseDown = (e: React.MouseEvent) => {
    if (isAuthenticated) return;
    e.preventDefault();
    isDragging.current = true;
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
  };

  const handleTouchStart = (e: React.TouchEvent) => {
    if (isAuthenticated) return;
    e.preventDefault();
    isDragging.current = true;
    document.addEventListener('touchmove', handleTouchMove as any);
    document.addEventListener('touchend', handleTouchEnd);
  };

  const handleMouseMove = (e: MouseEvent) => {
    if (isDragging.current && dragRef.current) {
      const rect = dragRef.current.getBoundingClientRect();
      const progress = Math.min(Math.max((e.clientX - rect.left) / (rect.width - 60), 0), 1);
      setDragProgress(progress);
      
      if (progress >= 0.95) {
        setIsAuthenticated(true);
        isDragging.current = false;
        document.removeEventListener('mousemove', handleMouseMove);
        document.removeEventListener('mouseup', handleMouseUp);
        setTimeout(() => setPhase('control'), 1500);
      }
    }
  };

  const handleTouchMove = (e: TouchEvent) => {
    if (isDragging.current && dragRef.current) {
      e.preventDefault();
      const touch = e.touches[0];
      const rect = dragRef.current.getBoundingClientRect();
      const progress = Math.min(Math.max((touch.clientX - rect.left) / (rect.width - 60), 0), 1);
      setDragProgress(progress);
      
      if (progress >= 0.95) {
        setIsAuthenticated(true);
        isDragging.current = false;
        document.removeEventListener('touchmove', handleTouchMove as any);
        document.removeEventListener('touchend', handleTouchEnd);
        setTimeout(() => setPhase('control'), 1500);
      }
    }
  };

  const handleMouseUp = () => {
    isDragging.current = false;
    document.removeEventListener('mousemove', handleMouseMove);
    document.removeEventListener('mouseup', handleMouseUp);
    
    if (dragProgress < 0.95) {
      setDragProgress(0); // Snap back
    }
  };

  const handleTouchEnd = () => {
    isDragging.current = false;
    document.removeEventListener('touchmove', handleTouchMove as any);
    document.removeEventListener('touchend', handleTouchEnd);
    
    if (dragProgress < 0.95) {
      setDragProgress(0); // Snap back
    }
  };

  // Phase 3: Mission Navigation
  const scrollMission = (direction: 'up' | 'down') => {
    setCurrentMissionIndex(prev => {
      if (direction === 'up') {
        return (prev - 1 + MISSIONS.length) % MISSIONS.length;
      } else {
        return (prev + 1) % MISSIONS.length;
      }
    });
  };

  // Render logic for each phase
  const renderPhase = () => {
    switch (phase) {
      case 'booting':
        return (
          <motion.div
            key="booting"
            className="min-h-screen bg-[#1A0D33] text-[#8A2BE2] font-mono flex items-center justify-center"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
          >
            <AnimatePresence>
              {showStatic && (
                <motion.div
                  className="absolute inset-0 bg-black opacity-70 z-10"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 0.7, transition: { duration: 0.1 } }}
                  exit={{ opacity: 0 }}
                  style={{
                    backgroundImage: 'url(data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7)',
                    backgroundSize: 'cover',
                    backgroundRepeat: 'no-repeat',
                  }}
                />
              )}
            </AnimatePresence>
            <pre className="text-lg md:text-2xl whitespace-pre-wrap">
              {bootingText}
              <span className="animate-pulse">█</span>
            </pre>
          </motion.div>
        );

      case 'clearance':
        return (
          <motion.div
            key="clearance"
            className="min-h-screen bg-gradient-to-br from-[#1A0D33] via-purple-900 to-black text-white flex items-center justify-center"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1, transition: { duration: 0.5 } }}
          >
            <div className="text-center space-y-8 z-10">
              <motion.div 
                initial={{ y: -20, opacity: 0 }}
                animate={{ y: 0, opacity: 1, transition: { delay: 0.2 } }}
                className="space-y-4"
              >
                <Shield className="mx-auto text-[#8A2BE2]" size={48} />
                <h2 className="text-3xl font-bold text-purple-300">OPERATIVE AUTHENTICATION</h2>
                <p className="text-gray-400">Drag security latch to access mission terminal.</p>
              </motion.div>

              <motion.div 
                initial={{ y: 20, opacity: 0 }}
                animate={{ y: 0, opacity: 1, transition: { delay: 0.4 } }}
                className="bg-black/50 rounded-xl p-8 border border-purple-500/30 backdrop-blur-lg"
              >
                <div
                  ref={dragRef}
                  className="relative w-80 h-16 bg-gray-800 rounded-full border border-purple-500/50 mx-auto cursor-pointer select-none overflow-hidden"
                  onMouseDown={handleMouseDown}
                  onTouchStart={handleTouchStart}
                >
                  {/* Background glow effect */}
                  <div className="absolute inset-0 bg-gradient-to-r from-purple-900/30 via-purple-600/40 to-purple-400/30 rounded-full animate-pulse" />
                  
                  {/* Progress fill with enhanced animation */}
                  <motion.div
                    className="absolute inset-1 bg-gradient-to-r from-purple-600 via-purple-500 to-magenta-500 rounded-full"
                    style={{ width: `${dragProgress * 100}%` }}
                    transition={{ type: 'spring', stiffness: 400, damping: 25 }}
                  />
                  
                  {/* Slider handle with enhanced styling */}
                  <motion.div
                    className="absolute top-1 w-14 h-14 bg-gradient-to-r from-[#8A2BE2] via-[#FF00FF] to-[#00FFFF] rounded-full shadow-lg flex items-center justify-center border-2 border-white/20"
                    style={{ 
                      left: `${dragProgress * (100 - 17.5)}%`,
                      boxShadow: isAuthenticated 
                        ? '0 0 20px #00FF00, 0 0 40px #00FF00, 0 0 60px #00FF00' 
                        : '0 0 15px #8A2BE2, 0 0 30px #8A2BE2'
                    }}
                    transition={{ type: 'spring', stiffness: 400, damping: 25 }}
                  >
                    <motion.div
                      animate={{ 
                        rotate: isAuthenticated ? 360 : 0,
                        scale: isAuthenticated ? 1.2 : 1
                      }}
                      transition={{ duration: 0.5 }}
                    >
                      {isAuthenticated ? <Unlock size={24} className="text-green-400" /> : <Lock size={24} className="text-white" />}
                    </motion.div>
                  </motion.div>
                  
                  {/* Progress text overlay */}
                  <div className="absolute inset-0 flex items-center justify-center text-white font-mono text-sm font-bold pointer-events-none">
                    {Math.round(dragProgress * 100)}%
                  </div>
                </div>
                <AnimatePresence>
                  {isAuthenticated && (
                    <motion.div
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0, transition: { delay: 0.2 } }}
                      className="mt-4 text-green-400"
                    >
                      ACCESS GRANTED. INITIALIZING INTERFACE...
                    </motion.div>
                  )}
                </AnimatePresence>
              </motion.div>
            </div>
          </motion.div>
        );

      case 'control':
        return (
          <motion.div
            key="control"
            className="min-h-screen bg-black text-white relative overflow-hidden"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1, transition: { duration: 1 } }}
          >
            {/* Matrix Rain Background */}
            <div className="absolute inset-0 overflow-hidden">
              {[...Array(50)].map((_, i) => (
                <div
                  key={i}
                  className="absolute text-green-400 font-mono text-sm opacity-70"
                  style={{
                    left: `${Math.random() * 100}%`,
                    animationDelay: `${Math.random() * 5}s`,
                    animation: `matrixFall ${3 + Math.random() * 4}s linear infinite`,
                  }}
                >
                  {String.fromCharCode(0x30A0 + Math.random() * 96)}
                </div>
              ))}
            </div>
            
            {/* Floating Code Snippets */}
            <div className="absolute inset-0 overflow-hidden pointer-events-none">
              {[...Array(15)].map((_, i) => (
                <div
                  key={i}
                  className="absolute font-mono text-xs text-cyan-400/30 whitespace-nowrap"
                  style={{
                    left: `${Math.random() * 100}%`,
                    top: `${Math.random() * 100}%`,
                    animationDelay: `${Math.random() * 10}s`,
                    animation: `codeFloat ${8 + Math.random() * 4}s ease-in-out infinite`,
                  }}
                >
                  {[
                    'function hackAI() { return "SUCCESS"; }',
                    'if (security.breached) { initiate.protocol(); }',
                    'const mission = await decrypt(data);',
                    'while(true) { scan.vulnerabilities(); }',
                    'neural.network.infiltrate(target);',
                    '01001000 01000001 01000011 01001011',
                    'quantum.encrypt(masterKey);',
                    'system.override.enabled = true;',
                  ][Math.floor(Math.random() * 8)]}
                </div>
              ))}
            </div>
            
            {/* Cyber Grid Background */}
            <div className="absolute inset-0 bg-gradient-to-br from-emerald-900/20 via-black to-purple-900/20" />
            <div className="absolute inset-0" style={{
              backgroundImage: `
                linear-gradient(rgba(0, 255, 65, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 65, 0.1) 1px, transparent 1px)
              `,
              backgroundSize: '30px 30px',
              animation: 'gridMove 20s linear infinite',
            }} />
            
            {/* Scanning Lines */}
            <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-cyan-400 to-transparent animate-pulse" />
            <div className="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-green-400 to-transparent animate-pulse" />
            
            {/* Vertical Scanlines */}
            {[...Array(5)].map((_, i) => (
              <div
                key={i}
                className="absolute top-0 w-px h-full bg-gradient-to-b from-transparent via-cyan-400/50 to-transparent"
                style={{
                  left: `${20 + i * 20}%`,
                  animationDelay: `${i * 2}s`,
                  animation: 'scanlineVertical 8s ease-in-out infinite',
                }}
              />
            ))}

            <Header />
            
            <div className="relative z-10 flex flex-col items-center justify-center min-h-screen py-8">
              {/* Hacking Control Terminal Header */}
              <motion.div 
                className="text-center mb-8"
                initial={{ y: -50, opacity: 0 }}
                animate={{ y: 0, opacity: 1, transition: { delay: 0.5 } }}
              >
                <div className="flex items-center justify-center gap-4 mb-4">
                  <div className="w-8 h-8 bg-red-500 rounded-full animate-pulse shadow-lg shadow-red-500/50" />
                  <h1 className="text-4xl font-bold font-mono bg-gradient-to-r from-green-400 via-cyan-400 to-purple-400 bg-clip-text text-transparent">
                    [ OPERATIVE MISSION TERMINAL ]
                  </h1>
                  <div className="w-8 h-8 bg-green-500 rounded-full animate-pulse shadow-lg shadow-green-500/50" />
                </div>
                <div className="flex items-center justify-center gap-2 text-green-400 font-mono text-sm">
                  <span>&gt;</span>
                  <span className="animate-pulse">SECURE_CONNECTION_ESTABLISHED</span>
                  <span>&gt;</span>
                </div>
              </motion.div>
              
              {/* Mission Carousel Container */}
              <div className="w-full max-w-7xl h-[75vh] relative">
                {/* Carousel Navigation */}
                <div className="absolute top-4 left-1/2 transform -translate-x-1/2 z-30 flex items-center gap-6">
                  <motion.button 
                    onClick={() => scrollMission('up')} 
                    className="group relative p-4 bg-gray-900/80 border border-cyan-400/60 rounded-lg text-cyan-400 hover:text-white transition-all overflow-hidden"
                    whileHover={{ scale: 1.05, boxShadow: '0 0 20px rgba(34, 211, 238, 0.4)' }}
                    whileTap={{ scale: 0.95 }}
                  >
                    <div className="absolute inset-0 bg-gradient-to-r from-cyan-600/0 via-cyan-600/20 to-cyan-600/0 opacity-0 group-hover:opacity-100 transition-opacity" />
                    <ChevronUp size={24} className="relative z-10" />
                  </motion.button>
                  
                  <div className="px-6 py-3 bg-black/80 border-2 border-green-400/50 rounded-lg text-green-400 font-mono text-lg font-bold shadow-lg shadow-green-500/20">
                    MISSION [{String(currentMissionIndex + 1).padStart(2, '0')}/{MISSIONS.length.toString().padStart(2, '0')}]
                  </div>
                  
                  <motion.button 
                    onClick={() => scrollMission('down')} 
                    className="group relative p-4 bg-gray-900/80 border border-cyan-400/60 rounded-lg text-cyan-400 hover:text-white transition-all overflow-hidden"
                    whileHover={{ scale: 1.05, boxShadow: '0 0 20px rgba(34, 211, 238, 0.4)' }}
                    whileTap={{ scale: 0.95 }}
                  >
                    <div className="absolute inset-0 bg-gradient-to-r from-cyan-600/0 via-cyan-600/20 to-cyan-600/0 opacity-0 group-hover:opacity-100 transition-opacity" />
                    <ChevronDown size={24} className="relative z-10" />
                  </motion.button>
                </div>

                {/* Advanced Mission Carousel */}
                <div className="relative h-full overflow-hidden">
                  <div className="flex items-center justify-center h-full">
                    <div className="relative w-full max-w-5xl h-full flex items-center justify-center">
                      <AnimatePresence mode="wait">
                        {MISSIONS.map((mission, index) => {
                          const offset = index - currentMissionIndex;
                          const isActive = offset === 0;
                          const isVisible = Math.abs(offset) <= 2;
                          
                          if (!isVisible) return null;
                          
                          return (
                            <motion.div
                              key={mission.id}
                              className="absolute w-full max-w-4xl cursor-pointer"
                              initial={{ 
                                x: offset * 400, 
                                opacity: 0, 
                                scale: 0.7,
                                rotateY: offset * 45,
                                z: -Math.abs(offset) * 100
                              }}
                              animate={{
                                x: offset * 350,
                                opacity: isActive ? 1 : Math.abs(offset) === 1 ? 0.6 : 0.3,
                                scale: isActive ? 1 : Math.abs(offset) === 1 ? 0.85 : 0.7,
                                rotateY: offset * 25,
                                z: -Math.abs(offset) * 50,
                                transition: {
                                  type: 'spring',
                                  stiffness: 100,
                                  damping: 20,
                                  duration: 0.6
                                }
                              }}
                              onClick={() => !isActive && setCurrentMissionIndex(index)}
                              style={{ 
                                transformStyle: 'preserve-3d',
                                zIndex: 100 - Math.abs(offset)
                              }}
                            >
                              {/* Mission Terminal Card */}
                              <div className={`relative h-[60vh] rounded-2xl border-2 backdrop-blur-xl transition-all duration-500 ${
                                isActive 
                                  ? 'border-green-400 bg-gradient-to-br from-black/80 via-green-900/30 to-black/80 shadow-2xl shadow-green-500/20' 
                                  : 'border-cyan-400/40 bg-gradient-to-br from-black/60 via-gray-900/30 to-black/60'
                              }`}>
                                {/* Terminal Header */}
                                <div className={`flex items-center justify-between p-4 border-b ${
                                  isActive ? 'border-green-400/50' : 'border-cyan-400/30'
                                }`}>
                                  <div className="flex items-center gap-3">
                                    <div className={`w-3 h-3 rounded-full ${
                                      isActive ? 'bg-green-400 animate-pulse' : 'bg-gray-500'
                                    }`} />
                                    <div className={`w-3 h-3 rounded-full ${
                                      isActive ? 'bg-yellow-400' : 'bg-gray-500'
                                    }`} />
                                    <div className={`w-3 h-3 rounded-full ${
                                      isActive ? 'bg-red-400' : 'bg-gray-500'
                                    }`} />
                                  </div>
                                  <div className="text-xs font-mono text-gray-400">
                                    [{mission.id}] - CLASSIFIED
                                  </div>
                                </div>

                                {/* Mission Content */}
                                <div className="p-6 h-full flex flex-col justify-between">
                                  {/* Mission Header */}
                                  <div className="mb-6">
                                    <motion.h2 
                                      className={`text-2xl font-bold font-mono mb-2 ${
                                        isActive ? 'text-green-400' : 'text-cyan-400'
                                      }`}
                                      animate={isActive ? { 
                                        textShadow: '0 0 10px #4ade80',
                                        transition: { duration: 2, repeat: Infinity, repeatType: 'reverse' }
                                      } : {}}
                                    >
                                      &gt; MISSION: {mission.name}
                                    </motion.h2>
                                    <motion.div 
                                      className={`text-sm font-mono mb-4 ${
                                        isActive ? 'text-green-300' : 'text-cyan-300'
                                      }`}
                                      animate={isActive ? {
                                        opacity: [1, 0.5, 1],
                                        transition: { duration: 3, repeat: Infinity }
                                      } : {}}
                                    >
                                      OBJECTIVE: {mission.objective}
                                    </motion.div>
                                  </div>

                                  {/* Terminal Content */}
                                  <div className="flex-1 overflow-hidden">
                                    <div className="bg-black/50 rounded-lg p-4 border border-green-400/30 h-full">
                                      <div className="flex items-center gap-2 mb-3">
                                        <span className="text-green-400 font-mono text-sm">&gt;_</span>
                                        <span className="text-green-400 font-mono text-sm animate-pulse">OPERATION_BRIEFING.exe</span>
                                      </div>
                                      <div className="text-green-300 font-mono text-sm leading-relaxed overflow-y-auto max-h-40">
                                        <motion.div
                                          initial={{ opacity: 0 }}
                                          animate={{ opacity: 1 }}
                                          transition={{ duration: 2, delay: 0.5 }}
                                        >
                                          {mission.description}
                                        </motion.div>
                                      </div>
                                    </div>
                                  </div>

                                  {/* Action Section */}
                                  <div className="mt-6">
                                    {isActive ? (
                                      <motion.button 
                                        className="w-full py-3 bg-transparent border-2 border-green-400 text-green-400 rounded-lg font-bold font-mono relative overflow-hidden group"
                                        whileHover="hover"
                                        whileTap={{ scale: 0.95 }}
                                      >
                                        <motion.span
                                          variants={{
                                            hover: { 
                                              textShadow: '0 0 10px #4ade80',
                                              color: '#000'
                                            }
                                          }}
                                          className="relative z-10 text-lg"
                                        >
                                          &gt; INITIATE_MISSION.exe
                                        </motion.span>
                                        <motion.div 
                                          className="absolute inset-0 bg-green-400"
                                          variants={{ hover: { opacity: 0.9 } }}
                                          initial={{ opacity: 0 }}
                                        />
                                        <div className="absolute top-0 left-0 w-full h-full bg-gradient-to-r from-green-400/0 via-green-400/50 to-green-400/0 animate-pulse" />
                                      </motion.button>
                                    ) : (
                                      <button className="w-full py-3 bg-gray-800/50 border border-gray-600/50 text-gray-500 rounded-lg font-mono text-sm cursor-not-allowed">
                                        MISSION_LOCKED
                                      </button>
                                    )}
                                  </div>
                                </div>
                              </div>
                            </motion.div>
                          );
                        })}
                      </AnimatePresence>
                    </div>
                  </div>
                </div>

                {/* Mission Queue Indicator */}
                <div className="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-30">
                  <div className="flex items-center gap-2 px-6 py-3 bg-black/80 border border-green-400/50 rounded-full">
                    <div className="text-green-400 font-mono text-sm mr-2">QUEUE:</div>
                    {MISSIONS.map((_, index) => (
                      <motion.div
                        key={index}
                        className={`w-2 h-2 rounded-full cursor-pointer transition-all ${
                          index === currentMissionIndex 
                            ? 'bg-green-400 shadow-lg shadow-green-400/50' 
                            : 'bg-gray-600 hover:bg-gray-400'
                        }`}
                        onClick={() => setCurrentMissionIndex(index)}
                        whileHover={{ scale: 1.5 }}
                        animate={index === currentMissionIndex ? {
                          scale: [1, 1.3, 1],
                          transition: { duration: 2, repeat: Infinity }
                        } : {}}
                      />
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <Footer />
          </motion.div>
        );
    }
  };

  return (
    <>
      <AnimatePresence mode="wait">
        {renderPhase()}
      </AnimatePresence>
      <style jsx global>{`
        @keyframes powerUp {
          from { opacity: 0.1; filter: brightness(0.5); }
          to { opacity: 0.3; filter: brightness(1); }
        }
        @keyframes breathingGlow {
          0%, 100% { filter: brightness(1); }
          50% { filter: brightness(1.2); }
        }
        @keyframes scanline {
          0% { transform: translateY(-100%); }
          100% { transform: translateY(200%); }
        }
        .animate-scanline {
          animation: scanline 10s linear infinite;
        }
        .perspective-1000 {
          perspective: 1000px;
        }
        .text-magenta-500 {
          color: #FF00FF;
        }
        .border-magenta-500 {
          border-color: #FF00FF;
        }
        .bg-magenta-500 {
          background-color: #FF00FF;
        }
      `}</style>
    </>
  );
}

